# Template for local settings. Copy it:  cp .env.example .env
# .env is git-ignored. Never commit real values.

# --- PostgreSQL (used by Docker Compose and the app) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=merchant
# Generate one: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=merchant_onboarding

# --- Redis (BullMQ queue for the background risk check) ---
REDIS_HOST=localhost
REDIS_PORT=6379
