# Template for local settings. Copy it:  cp .env.example .env
# .env is git-ignored. Never commit real values.
# Empty values below must be filled in; the app refuses to start without them.

# --- App ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (used by Docker Compose and the app) ---
POSTGRES_HOST=localhost
# 5433 on purpose: a Postgres installed on your machine usually holds 5432.
POSTGRES_PORT=5433
POSTGRES_USER=merchant
# Generate one: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=merchant_onboarding

# --- Redis (BullMQ queue for the background risk check) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Auth ---
# Signs access tokens. Generate one: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT=5
AUTH_RATE_WINDOW_SECONDS=60

# --- Field encryption for owner national IDs ---
# 32 random bytes, base64. Generate one: openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# --- Background risk check ---
RUN_RISK_WORKER=true
RISK_WORKER_CONCURRENCY=5
RISK_JOB_ATTEMPTS=4
RISK_JOB_BACKOFF_MS=2000
RISK_PROVIDER_FAILURE_RATE=0.2
RISK_PROVIDER_MAX_DELAY_MS=1500

# --- Seed script only (npm run seed) ---
# Password given to every demo staff account. At least 12 characters.
SEED_USER_PASSWORD=
